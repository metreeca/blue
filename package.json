{
  "name": "@metreeca/blue",
  "version": "0.9.1",
  "description": "Declarative blueprints for model-driven linked data processing.",
  "keywords": [
    "typescript",
    "utilities"
  ],
  "homepage": "https://metreeca.github.io/blue/",
  "bugs": {
    "url": "https://github.com/metreeca/blue/issues",
    "email": "info@metreeca.com"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metreeca/blue.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./boolean": "./dist/boolean.js",
    "./number": "./dist/number.js",
    "./string": "./dist/string.js",
    "./local": "./dist/local.js",
    "./resource": "./dist/resource.js"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist docs node_modules",
    "setup": "npm install && npm audit fix",
    "build": "rm -rf dist docs & tsc -p tsconfig.build.json && npx typedoc",
    "check": "npx vitest --typecheck run",
    "watch": "npx tsc --watch",
    "proof": "npm run build && (npx typedoc --watch & npx five-server docs --open)"
  },
  "dependencies": {
    "@metreeca/core": "^0.9.18",
    "@metreeca/qest": "^0.9.2"
  },
  "devDependencies": {
    "five-server": "^0.4.5",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  }
}
