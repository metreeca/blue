{
  "name": "@metreeca/blue",
  "version": "0.10.0",
  "description": "Declarative blueprints for model-driven linked data processing.",
  "keywords": [
    "typescript",
    "utilities"
  ],
  "homepage": "https://metreeca.github.io/blue/",
  "bugs": {
    "url": "https://github.com/metreeca/blue/issues",
    "email": "info@metreeca.com"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metreeca/blue.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./value": "./dist/value/index.js",
    "./union": "./dist/union/index.js",
    "./boolean": "./dist/boolean/index.js",
    "./number": "./dist/number/index.js",
    "./string": "./dist/string/index.js",
    "./dictionary": "./dist/dictionary/index.js",
    "./reference": "./dist/reference/index.js",
    "./resource": "./dist/resource/index.js"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "rm -rf dist docs node_modules",
    "prime": "npm ci",
    "setup": "npm ci && sh package.sh",
    "build": "rm -rf dist docs && tsc -p tsconfig.build.json && npx typedoc",
    "check": "npx vitest --typecheck run",
    "proof": "npm run build && (npx typedoc --watch & npx five-server docs --open)"
  },
  "dependencies": {
    "@metreeca/core": "^0.10.0",
    "@metreeca/qest": "^0.10.0"
  },
  "devDependencies": {
    "five-server": "^0.4.5",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  }
}
