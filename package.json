{
  "name": "@metreeca/blue",
  "version": "0.13.0",
  "description": "Declarative blueprints for model-driven linked data processing.",
  "keywords": [
    "typescript",
    "json-ld",
    "shacl",
    "validation",
    "model-driven"
  ],
  "homepage": "https://metreeca.github.io/blue/",
  "bugs": {
    "url": "https://github.com/metreeca/blue/issues",
    "email": "info@metreeca.com"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metreeca/blue.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@metreeca/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./value": {
      "@metreeca/source": "./src/value/index.ts",
      "default": "./dist/value/index.js"
    },
    "./union": {
      "@metreeca/source": "./src/union/index.ts",
      "default": "./dist/union/index.js"
    },
    "./boolean": {
      "@metreeca/source": "./src/boolean/index.ts",
      "default": "./dist/boolean/index.js"
    },
    "./number": {
      "@metreeca/source": "./src/number/index.ts",
      "default": "./dist/number/index.js"
    },
    "./string": {
      "@metreeca/source": "./src/string/index.ts",
      "default": "./dist/string/index.js"
    },
    "./dictionary": {
      "@metreeca/source": "./src/dictionary/index.ts",
      "default": "./dist/dictionary/index.js"
    },
    "./reference": {
      "@metreeca/source": "./src/reference/index.ts",
      "default": "./dist/reference/index.js"
    },
    "./resource": {
      "@metreeca/source": "./src/resource/index.ts",
      "default": "./dist/resource/index.js"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "rm dist docs node_modules",
    "prime": "npm ci",
    "setup": "npm ci && ln",
    "build": "rm dist docs && tsc -p tsconfig.build.json && npx typedoc",
    "check": "npx vitest --typecheck run",
    "proof": "npx typedoc && (npx typedoc --watch & npx wds --root-dir docs --watch --open)"
  },
  "dependencies": {
    "@metreeca/core": "^0.13.0",
    "@metreeca/qest": "^0.13.0",
    "json-schema-typed": "^9.0.0"
  },
  "devDependencies": {
    "@metreeca/rack": "^0.5.0",
    "@web/dev-server": "^1.0.0",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
