{
  "tsconfig": "./tsconfig.build.json",
  "plugin": [
    "./typedoc.mjs"
  ],
  "excludeInternal": true,
  "includeVersion": true,
  "sortEntryPoints": false,
  "sort": [
    "source-order"
  ],
  "categorizeByGroup": true,
